{
  "expo": {
    "name": "arcade",
    "slug": "arcade",
    "version": "1.0.0",
    "owner": "gl-studio",
    "scheme": "arcade",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#333D51",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#333D51"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#333D51",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "description": "A video game backlog you can actually finish",
    "githubUrl": "https://github.com/ginoleeswan/arcade"
  }
}
