{
  "expo": {
    "name": "Sidequest",
    "slug": "sidequest",
    "version": "1.0.0",
    "owner": "gl-studio",
    "scheme": "sidequest",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#333D51",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.glstudio.sidequest"
    },
    "android": {
      "package": "com.glstudio.sidequest",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#272F3F"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#272F3F",
          "image": "./assets/splash.png",
          "imageWidth": 180
        }
      ],
      "expo-status-bar",
      "expo-video",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "Sidequest files your planned evenings and finished games into a calendar of its own, on this device."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Discover games worth your limited time",
    "githubUrl": "https://github.com/ginoleeswan/sidequest"
  }
}
