{
  "expo": {
    "name": "Sidequest",
    "slug": "sidequest",
    "version": "1.0.0",
    "owner": "gl-studio",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "scheme": "sidequest",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#333D51",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.glstudio.sidequest",
      "appleTeamId": "A85929B4HV",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.glstudio.sidequest"
        ]
      }
    },
    "android": {
      "package": "com.glstudio.sidequest",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#272F3F"
      },
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#272F3F",
          "image": "./assets/splash.png",
          "imageWidth": 180
        }
      ],
      "expo-status-bar",
      "expo-video",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "Sidequest files your planned evenings and finished games into a calendar of its own, on this device."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F2A93B",
          "defaultChannel": "evenings",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Discover games worth your limited time",
    "githubUrl": "https://github.com/ginoleeswan/sidequest",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a9dd675-5fbe-4ee3-a12c-2137d1ea9f12"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/3a9dd675-5fbe-4ee3-a12c-2137d1ea9f12"
    }
  }
}
