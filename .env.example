# RAWG API key — https://rawg.io/apidocs
#
# RAWG_API_KEY (no EXPO_PUBLIC_ prefix) is the one that matters on web: it
# stays server-side and is injected by the /rawg proxy (api/rawg-proxy.ts
# in production, the Metro dev-server middleware in metro.config.js
# locally), so it never reaches the browser. Required for `expo start
# --web` to load any game data.
RAWG_API_KEY=your-key-here

# EXPO_PUBLIC_ vars are embedded in the client bundle. This copy is only
# read on native (iOS/Android), which calls RAWG directly and has no
# same-origin proxy to hide behind — a key in an app binary is
# extractable regardless, so there's nothing gained by hiding it there.
# Not needed for `expo start --web` or the Vercel deployment.
EXPO_PUBLIC_RAWG_API_KEY=your-key-here
