# RAWG API key — https://rawg.io/apidocs
#
# RAWG_API_KEY (no EXPO_PUBLIC_ prefix) is the one that matters on web: it
# stays server-side and is injected by the /rawg proxy (api/rawg-proxy.ts
# in production, the Metro dev-server middleware in metro.config.js
# locally), so it never reaches the browser. Required for `expo start
# --web` to load any game data.
RAWG_API_KEY=your-key-here

# EXPO_PUBLIC_ vars are embedded in the client bundle. This copy is only
# read on native (iOS/Android), which calls RAWG directly and has no
# same-origin proxy to hide behind — a key in an app binary is
# extractable regardless, so there's nothing gained by hiding it there.
# Not needed for `expo start --web` or the Vercel deployment.
EXPO_PUBLIC_RAWG_API_KEY=your-key-here

# ── Supabase (optional sign-in / sync) ─────────────────────────────────
# Both are EXPO_PUBLIC_ on purpose: the URL and the anon key are designed
# to be public — row-level security is what protects the data. Leave them
# unset and the app runs with no account anywhere, which is a supported
# build.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-key

# ── Google sign-in (optional, native + web) ────────────────────────────
# OAuth client IDs are public identifiers, safe in the bundle.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# ── Server-only keys — NEVER add an EXPO_PUBLIC_ prefix to these ───────
# They are read exclusively by the Vercel functions in api/, so they
# belong in the Vercel project environment (and locally here for
# `vercel dev`). An EXPO_PUBLIC_ prefix would bake them into the client
# bundle where anyone can read them.

# Steam Web API key (api/steam.ts) — https://steamcommunity.com/dev/apikey
# Valve says to treat it like a password. Without it, Steam import
# degrades to a soft 503.
STEAM_API_KEY=your-steam-key

# Twitch app credentials (api/twitch.ts, api/igdb.ts) —
# https://dev.twitch.tv/console/apps. Power both live streams and IGDB
# time-to-beat. Without them, both features quietly sit out.
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
