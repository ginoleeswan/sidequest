{
  "name": "sidequest",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "postinstall": "patch-package",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "node scripts/build-sitemap.mjs && expo export --platform web",
    "test:hydration": "node e2e/hydration.mjs",
    "test:a11y": "node e2e/a11y.mjs",
    "test:perf": "node e2e/perf.mjs",
    "test:icons": "node e2e/icons.mjs",
    "lint:fix": "eslint . --fix",
    "prebuild": "expo prebuild --clean",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:prod": "eas build --profile production",
    "update:preview": "eas update --channel preview",
    "update:prod": "eas update --channel production",
    "fingerprint:generate": "expo-updates fingerprint:generate",
    "apple:secret": "node scripts/apple-client-secret.mjs",
    "test:coverage": "jest --coverage",
    "test:live": "jest --runInBand --config jest.live.config.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@expo/metro-runtime": "~57.0.11",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/query-sync-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "expo": "~57.0.15",
    "expo-apple-authentication": "~57.0.1",
    "expo-calendar": "~57.0.2",
    "expo-constants": "~57.0.14",
    "expo-dev-client": "~57.0.15",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-notifications": "~57.0.14",
    "expo-router": "~57.0.16",
    "expo-sharing": "~57.0.15",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.17",
    "expo-video": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/plugin-transform-dynamic-import": "^7.29.7",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "patch-package": "^8.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 20000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.integration\\.test\\.ts$"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|react-native-svg|@react-native-google-signin|@bacons))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "api/**/*.ts",
      "!src/**/__tests__/**",
      "!src/app/+html.tsx",
      "!src/**/*.d.ts",
      "!src/**/*.integration.test.ts",
      "!src/test-utils.tsx",
      "!api/test-utils.ts"
    ],
    "moduleNameMapper": {
      "\\.(woff|woff2)$": "<rootDir>/test/fileStub.js",
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^react-native($|/.*)": "<rootDir>/node_modules/react-native/$1",
      "^react-native-vector-icons$": "@expo/vector-icons",
      "^react-native-vector-icons/(.*)": "@expo/vector-icons/$1"
    },
    "coverageThreshold": {
      "global": {
        "lines": 85,
        "statements": 83,
        "branches": 73,
        "functions": 78
      }
    }
  }
}
